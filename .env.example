# Copiar como .env en la raiz del repo y completar los valores.
# Formato: CLAVE=valor, sin espacios alrededor del "=", sin comillas y sin comentarios
# al final de la linea (asi lo entienden igual python-dotenv y Docker).

# URL del webhook de Google Chat (debe empezar con https://)
PASSWORDCHAT=

# Logging. Hoy estas dos NO se leen del .env cuando se corre sin Docker: el logging se
# configura antes de cargar el .env (se unifica en el paso 12 del plan). Funcionan como
# variables de entorno del proceso (y con Docker, via env_file del compose).
# Carpeta de logs (por defecto logs/ en la raiz del repo)
# MONITOREO_LOG_DIR="logs/"
# Nivel minimo del archivo de log: DEBUG, INFO, WARNING, ERROR (por defecto INFO)
LOG_LEVEL=INFO

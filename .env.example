# Copiar como .env en la raiz del repo y completar los valores.
# Formato: CLAVE=valor, sin espacios alrededor del "=" y sin comentarios al final de la
# linea (asi lo entienden igual python-dotenv y Docker).
#
# Prioridad: si una variable ya esta definida en el entorno del proceso (a mano, o la que
# pasa Docker), gana sobre el valor de este archivo.
# Si algun valor es invalido, el monitoreo no arranca: sale con codigo 1 y explica el
# problema en stderr (Telegraf lo muestra en su log).

# ---------------------------------------------------------------- secretos

# Comunidad SNMP de lectura de los UPS. OBLIGATORIA.
SNMP_COMMUNITY=

# URL del webhook de Google Chat (tiene que empezar con https://).
# Si falta, el monitoreo funciona igual pero las alertas quedan pendientes hasta configurarla.
# Para probar desde tu maquina, usar el webhook de un espacio de prueba, no el real.
GOOGLE_CHAT_WEBHOOK_URL=

# ---------------------------------------------------------------- opcionales (valor por defecto)

# Segundos de espera por intento SNMP. Un OID sin respuesta cuesta
# SNMP_TIMEOUT * (1 + SNMP_RETRIES) segundos, y despues del primer timeout
# no se consultan mas OIDs de ese host.
SNMP_TIMEOUT=1
SNMP_RETRIES=1

# Segundos maximos para enviar un mensaje a Google Chat.
HTTP_TIMEOUT=10

# Hilos para consultar los equipos en paralelo.
MAX_WORKERS=13

# Nivel minimo del archivo de log: DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_LEVEL=INFO

# Carpeta de datos: la base errores.db y los logs (en <carpeta>/logs/).
# Una ruta relativa se toma desde la raiz del repo. Con Docker es el volumen.
MONITOREO_DATA_DIR=data
